# ── required ─────────────────────────────────────────────────────────────────
# Google Cloud console → APIs & Services → enable "YouTube Data API v3"
# → Credentials → Create API key → restrict it to YouTube Data API v3.
# Read-only public data: no OAuth, nothing can be changed on your channel.
YT_API_KEY=

# Handles, channel IDs (UC…) or channel URLs, comma-separated.
# If your distributor created an auto-generated "Topic" channel, add its UC… ID too.
YT_CHANNELS=@2b-lob

# ── promo ────────────────────────────────────────────────────────────────────
ARTIST_NAME=2b-lob
SITE_URL=https://fritog.lat
# Always included first; each video's own tags fill the remaining slots per platform
PROMO_HASHTAGS=2bLob,NewMusic,ElectronicMusic
# Appended to Reddit titles as "[Genre]", e.g. Melodic Techno
GENRE=

# ── watch daemon ─────────────────────────────────────────────────────────────
# Sync cadence (min 5m). A sync costs ~1 + 2·ceil(videos/50) quota units of 10,000/day.
WATCH_INTERVAL=6h

# Optional push notifications: ntfy topic URL (self-hosted or ntfy.sh) and/or a Discord webhook
NTFY_URL=
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=

# ── container ────────────────────────────────────────────────────────────────
# Host uid/gid that owns ./data (run `id -u; id -g`)
PUID=1000
PGID=1000
